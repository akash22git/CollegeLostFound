RewriteEngine On

# 1. Force HTTPS (Secure Padlock)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2. Protect .env file
<Files ".env">
    Require all denied
</Files>

# 3. Automatically remove .php from browser address bar (Redirects /items.php -> /items)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4. Clean URLs (e.g. /items loads public/items.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^([^.]+)$ public/$1.php [L,QSA]

# 5. Route all other requests (CSS, JS, Images, Homepage) to public/
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L,QSA]
