# Database Configuration
# Localhost (XAMPP / PHP built-in):
DB_HOST=localhost
DB_NAME=college_lost_found
DB_USER=root
DB_PASSWORD=

# For InfinityFree hosting, fill with your cPanel MySQL details:
# DB_HOST=sqlxxx.infinityfree.com
# DB_NAME=if0_xxxxxxxx_college_lost_found
# DB_USER=if0_xxxxxxxx
# DB_PASSWORD=your_vpanel_password

# Base Website URL
# Local: http://localhost:8000
# InfinityFree: https://yourdomain.infinityfreeapp.com
APP_URL=http://localhost:8000

# Email Sender Details
MAIL_FROM=support@college.edu
MAIL_FROM_NAME="College Lost & Found"

# Optional SMTP Configuration (Required for live emails on InfinityFree / Gmail / Brevo)
# If using Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_digit_gmail_app_password

# If using Brevo / Sendinblue (Free 300 emails/day):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=tls
# SMTP_USER=your_brevo_login
# SMTP_PASS=your_brevo_smtp_key
